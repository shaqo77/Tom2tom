# Copier en .env et adapter. Le vrai .env n'est JAMAIS versionné.
SECRET_KEY=changez-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Schéma applicatif. Laissé vide, le schéma « public » est utilisé.
# À renseigner sur tout hébergement où « public » est exposé par une API
# (Supabase sert « public » au rôle anonyme) : voir infra/sql/00_bootstrap_roles.sql.
DB_SCHEMA=
# Chiffrement du lien avec la base : vide en local, « require » à distance.
DB_SSLMODE=

# Rôle APPLICATIF : aucune création, soumis aux politiques d'isolation.
DATABASE_URL=postgres://sigf_app:dev_only_change_me@localhost:5432/sigf

# Rôle PROPRIÉTAIRE : migrations uniquement.
DATABASE_OWNER_URL=postgres://sigf_owner:dev_only_change_me@localhost:5432/sigf

# --- Variante Supabase (pooler en mode session, port 5432) ---
# L'accès direct db.<ref>.supabase.co n'a plus d'adresse IPv4 : passer par le pooler.
# Le caractère « @ » d'un mot de passe s'écrit « %40 » dans une URL.
# DB_SCHEMA=sigf
# DB_SSLMODE=require
# DATABASE_URL=postgres://sigf_app.<ref>:<mdp>@aws-1-<region>.pooler.supabase.com:5432/postgres
# DATABASE_OWNER_URL=postgres://postgres.<ref>:<mdp>@aws-1-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<clé publique>
